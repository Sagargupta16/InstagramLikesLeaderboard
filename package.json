{
  "name": "instagram-likes-leaderboard",
  "version": "2.2.1",
  "private": true,
  "scripts": {
    "dev": "npm run build && webpack serve --mode development",
    "build:bundle": "webpack --mode production",
    "embed": "node scripts/update-index.js public/index.html dist/dist.js",
    "build": "npm run build:bundle && npm run embed",
    "check:generated": "npm run build:bundle && node scripts/update-index.js --check public/index.html dist/dist.js",
    "lint": "eslint src/ \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:generated"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "css-loader": "7.1.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "sass": "1.102.0",
    "sass-loader": "16.0.8",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  },
  "overrides": {
    "qs": "6.15.3",
    "uuid": "11.1.1"
  }
}
