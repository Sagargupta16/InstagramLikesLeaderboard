{
  "name": "instagram-likes-leaderboard",
  "version": "2.2.2",
  "private": true,
  "scripts": {
    "dev": "npm run build && webpack serve --mode development",
    "build:bundle": "webpack --mode production",
    "embed": "node scripts/update-index.js public/index.html dist/dist.js",
    "build": "npm run build:bundle && npm run embed",
    "check:generated": "npm run build:bundle && node scripts/update-index.js --check public/index.html dist/dist.js",
    "lint": "eslint src/ \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:generated"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "css-loader": "7.1.5",
    "eslint": "10.9.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "sass": "1.103.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "14.0.2"
  }
}
